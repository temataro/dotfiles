#!/usr/bin/env bash
# =============================================================================
# agent-jail — Launch coding agents in a rootless Podman sandbox.
# Shares the selected repository and only the launched agent's required state.
# Copyright (c) 2026 Temesgen Ataro <ataro.temesgen@gmail.com>
# SPDX-License-Identifier: Apache-2.0
# =============================================================================
# Shared launcher for the jailed coding agents. Not called directly — use the
# thin wrappers: claude-sbx / codex-sbx / opencode-sbx / omp-sbx [path/to/repo].
#
#   <agent>-sbx [repo]                new session, permissions skipped
#   claude-sbx  [repo] --resume       Claude's session picker
#   claude-sbx  [repo] --continue     latest Claude session in this repo
#   codex-sbx   [repo] --resume       `codex resume` picker
#   codex-sbx   [repo] --continue     `codex resume --last`
#   opencode-sbx [repo] --continue    `-c`, continue last session
#   opencode-sbx [repo] --resume <id> `-s <id>`
#   claude-sbx  <repo> --legacy-resume  resume old /workspace sessions
#   <agent>-sbx <repo> bash           shell escape hatch
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

usage() {
    echo "usage: agent-jail {claude|codex|opencode|omp} [path/to/repo] [args...]" >&2
    exit 1
}

(($# >= 1)) || usage
AGENT="$1"
shift

repo_arg="$(pwd)"
if (($# > 0)) && [[ "$1" != -* ]]; then
    repo_arg="$1"
    shift
fi

if [[ "$AGENT" == omp ]]; then
    forwarded=()
    while (($#)); do
        case "$1" in
        --cwd) repo_arg="${2:?--cwd needs a project directory}"; shift 2 ;;
        --cwd=*) repo_arg="${1#--cwd=}"; shift ;;
        --) forwarded+=("$@"); break ;;
        *) forwarded+=("$1"); shift ;;
        esac
    done
    set -- "${forwarded[@]}"
fi

REPO="$(realpath "$repo_arg")"
[[ -d "$REPO" ]] || { echo "Error: '$REPO' is not a directory." >&2; exit 1; }

IMAGE="agent-jail:latest"
repo_name="$(basename "$REPO")"

# ── Per-agent wiring ──────────────────────────────────────────────────────────
# Each case sets: CONTAINER_NAME prefix, default command, state paths to
# pre-create and mount, and resume-flag translation.
ensure_dir() { [[ -d "$1" ]] || { (umask 077; mkdir -p "$1"); }; }
ensure_file() {
    if [[ ! -e "$1" ]]; then (umask 077; printf '{}\n' > "$1")
    elif [[ ! -f "$1" ]]; then echo "Error: '$1' exists but is not a regular file." >&2; exit 1
    fi
}

STATE_MOUNTS=()
AGENT_ENV=()
CONTAINER_REPO="$REPO"

case "$AGENT" in
claude)
    CLAUDE_DIR="$HOME/.claude"; CLAUDE_STATE="$HOME/.claude.json"
    ensure_dir "$CLAUDE_DIR"; ensure_file "$CLAUDE_STATE"
    STATE_MOUNTS=("--volume" "$CLAUDE_DIR:/root/.claude"
                  "--volume" "$CLAUDE_STATE:/root/.claude.json")
    CONTAINER_CMD=(claude --dangerously-skip-permissions)
    CONTAINER_NAME="cc-${repo_name//[^[:alnum:]_.-]/-}"
    if [[ "${1:-}" == "--legacy-resume" ]]; then
        shift
        CONTAINER_REPO="/workspace"
        CONTAINER_CMD+=(--resume "$@")
    fi
    ;;
codex)
    CODEX_DIR="$HOME/.codex"
    ensure_dir "$CODEX_DIR"
    STATE_MOUNTS=("--volume" "$CODEX_DIR:/root/.codex")
    CONTAINER_CMD=(codex --dangerously-bypass-approvals-and-sandbox)
    CONTAINER_NAME="cx-${repo_name//[^[:alnum:]_.-]/-}"
    if (($# > 0)) && [[ "$1" == "--continue" ]]; then
        shift; set -- resume --last "$@"
    elif (($# > 0)) && [[ "$1" == "--resume" ]]; then
        shift; set -- resume "$@"
    fi
    ;;
omp)
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    OMP_DGX_DIR="${OMP_DGX_DIR:-$SCRIPT_DIR/../agents/glm53-flash}"
    OMP_DGX_DIR="$(realpath "$OMP_DGX_DIR")"
    OMP_PROFILE="$OMP_DGX_DIR/generated/omp"
    [[ -r "$OMP_PROFILE/models.yml" ]] || python3 "$OMP_DGX_DIR/configure-omp.py"
    [[ -s "$OMP_DGX_DIR/secrets/api-key" ]] || { echo 'Missing GLM API key in the private deployment directory.' >&2; exit 1; }
    STATE_MOUNTS=("--volume" "$OMP_PROFILE:/root/.omp/agent"
                  "--volume" "$OMP_DGX_DIR/secrets/api-key:/run/secrets/dgx-glm:ro"
                  "--volume" "$OMP_DGX_DIR/secrets/api-key:$OMP_DGX_DIR/secrets/api-key:ro")
    # Preserve the generated profile's absolute instruction/skill references.
    # Do not expose Claude credentials or writable host instruction files.
    CLAUDE_ROOT="$(realpath "${OMP_CLAUDE_DIR:-$HOME/.claude}")"
    if [[ -f "$CLAUDE_ROOT/CLAUDE.md" ]]; then
        STATE_MOUNTS+=("--volume" "$CLAUDE_ROOT/CLAUDE.md:$CLAUDE_ROOT/CLAUDE.md:ro")
    fi
    if [[ -d "$CLAUDE_ROOT/skills" ]]; then
        STATE_MOUNTS+=("--volume" "$CLAUDE_ROOT/skills:$CLAUDE_ROOT/skills:ro")
    fi
    AGENT_ENV=(-e PI_CODING_AGENT_DIR=/root/.omp/agent)
    CONTAINER_CMD=(omp --auto-approve)
    CONTAINER_NAME="omp-${repo_name//[^[:alnum:]_.-]/-}"
    ;;
opencode)
    OC_CONFIG="$HOME/.config/opencode"; OC_DATA="$HOME/.local/share/opencode"
    ensure_dir "$OC_CONFIG"; ensure_dir "$OC_DATA"
    STATE_MOUNTS=("--volume" "$OC_CONFIG:/root/.config/opencode"
                  "--volume" "$OC_DATA:/root/.local/share/opencode")
    CONTAINER_CMD=(opencode)
    CONTAINER_NAME="oc-${repo_name//[^[:alnum:]_.-]/-}"
    while (($# > 0)); do
        case "$1" in
        --continue) shift; set - "$@" -c ;;
        --resume)   shift; set - "$@" -s "${1:?--resume needs a session id}"; shift ;;
        *)          break ;;
        esac
    done
    ;;
*)
    usage
    ;;
esac

# A leading option is appended to the default command; a non-option command
# replaces it entirely (the shell escape hatch).
if (($# > 0)); then
    if [[ "$1" == -* ]]; then
        CONTAINER_CMD+=("$@")
    else
        CONTAINER_CMD=("$@")
    fi
fi

if [[ "$AGENT" == omp ]]; then
    CONTAINER_CMD=(bash -c 'export GLM_API_KEY="$(</run/secrets/dgx-glm)"; exec "$@"' -- "${CONTAINER_CMD[@]}")
fi

# ── Repo mount (at its host path, so session identity matches) ────────────────
repo_mount_path="${REPO//\"/\"\"}"
if [[ "$CONTAINER_REPO" == "/workspace" ]]; then
    REPO_MOUNT=("--mount" "type=bind,\"source=$repo_mount_path\",\"target=/workspace\"")
else
    REPO_MOUNT=("--mount" "type=bind,\"source=$repo_mount_path\",\"target=$repo_mount_path\"")
fi

MOUNTS=("${REPO_MOUNT[@]}" "${STATE_MOUNTS[@]}")

# ── Git identity (env vars, not a mounted .gitconfig) ─────────────────────────
GIT_ENV=()
git_name="$(git -C "$REPO" config --get user.name 2>/dev/null || true)"
git_email="$(git -C "$REPO" config --get user.email 2>/dev/null || true)"
if [[ -n "$git_name" && -n "$git_email" ]]; then
    GIT_ENV+=("-e" "GIT_AUTHOR_NAME=$git_name" "-e" "GIT_AUTHOR_EMAIL=$git_email"
              "-e" "GIT_COMMITTER_NAME=$git_name" "-e" "GIT_COMMITTER_EMAIL=$git_email")
else
    echo "⚠  No host git user.name/user.email — $AGENT won't be able to commit." >&2
fi

# ── SSH agent forwarding ──────────────────────────────────────────────────────
SSH_ARGS=()
if [[ -n "${SSH_AUTH_SOCK:-}" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
    MOUNTS+=("--volume" "$SSH_AUTH_SOCK:/tmp/ssh-agent.sock:ro")
    SSH_ARGS=("-e" "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
else
    echo "⚠  SSH_AUTH_SOCK not found — git push/pull won't work inside the container." >&2
fi

# ── USB passthrough (hotplug-aware; keep-groups carries device-group access) ──
USB_ARGS=()
if [[ -d /dev/bus/usb ]]; then
    USB_ARGS=("--volume" "/dev/bus/usb:/dev/bus/usb" "--group-add" "keep-groups")
fi

# ── Run ───────────────────────────────────────────────────────────────────────
# Rootless podman maps container-root to your host user; IS_SANDBOX=1 lets
# Claude's skip-permissions run as root (codex/opencode ignore it).
exec podman run -it --rm \
    --name "$CONTAINER_NAME" \
    --hostname "sandbox" \
    --security-opt=label=disable \
    -e IS_SANDBOX=1 \
    "${AGENT_ENV[@]}" \
    "${GIT_ENV[@]}" \
    "${MOUNTS[@]}" \
    "${SSH_ARGS[@]}" \
    "${USB_ARGS[@]}" \
    -w "$CONTAINER_REPO" \
    "$IMAGE" "${CONTAINER_CMD[@]}"
