#!/usr/bin/env bash
# Sandbox entry banner — shown for ~1s on entering the container, then cleared
# before the real command (a coding agent, or a shell override) takes over.
set -e

printf '\033[1;33m'                       # bold amber
cat <<'BANNER'

     ___   __ __  ______ ____   _____ _____
    / _ | / // / /_  __//  _/  / ___// ___/
   / __ |/ // /_  / / _/ /    / /__ _\ \
  /_/ |_|_//_//_/ /_/___/     \___//____/

BANNER
printf '\033[0;90m'                        # dim grey subtitle
printf '    jailed to mounted repo  ·  other host files hidden  ·  bypass perms on\n'
printf '\033[0m\n'

sleep 1
printf '\033c'                             # full reset — wipes the banner

exec "$@"
